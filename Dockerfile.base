FROM debian:13-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    gh \
    git \
    htop \
    locales \
    net-tools \
    netcat-openbsd \
    openssh-server \
    python3 \
    python3-pip \
    python3-venv \
    sudo \
    vim \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Generate locale to prevent setlocale warnings from SSH clients
RUN sed -i 's/# en_US.UTF-8/en_US.UTF-8/' /etc/locale.gen && locale-gen

# Create "me" user with sudo access
RUN useradd -m -s /bin/bash me && \
    echo "me ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Configure SSH
COPY sshd_cm.conf /etc/ssh/sshd_config.d/cm.conf
RUN mkdir -p /var/run/sshd && \
    sed -i \
        -e 's/^\([[:space:]]*session[[:space:]]\+optional[[:space:]]\+pam_motd\.so.*\)$/# \1/' \
        -e 's/^\([[:space:]]*session[[:space:]]\+optional[[:space:]]\+pam_lastlog\.so.*\)$/# \1/' \
        /etc/pam.d/sshd && \
    rm -f /etc/motd /run/motd.dynamic

# Setup SSH directory for me user
RUN mkdir -p /home/me/.ssh && \
    chmod 700 /home/me/.ssh && \
    chown me:me /home/me/.ssh

USER root
